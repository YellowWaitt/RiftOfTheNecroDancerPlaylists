{
	// Place your RiftOfTheNecroDancerPlaylists workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Harmony patch class": {
		"prefix": "harmony-class",
		"body": [
			"[HarmonyPatch(typeof($1))]",
			"internal static class ${1}Patch",
			"{",
			"\t$0",
			"}"
		],
		"description": "Structure of an Harmony patch class"
	},
	"Harmony prefix": {
		"prefix": "harmony-prefix",
		"body": [
			"[HarmonyPrefix]",
			"[HarmonyPatch(\"$1\")]",
			"private static bool $1_Prefix($2)",
			"{",
			"\t$0",
			"\treturn true;",
			"}"
		],
		"description": "Structure of an Harmony prefix method"
	},
	"Harmony postfix": {
		"prefix": "harmony-postfix",
		"body": [
			"[HarmonyPostfix]",
			"[HarmonyPatch(\"$1\")]",
			"private static void $1_Postfix($2)",
			"{",
			"\t$0",
			"}"
		],
		"description": "Structure of an Harmony postfix method"
	},
	"Plugin logger message": {
		"prefix": "plugin-log-message",
		"body": "Plugin.Logger.LogMessage($\"{$0}\");"
	},
	"Plugin logger info": {
		"prefix": "plugin-log-info",
		"body": "Plugin.Logger.LogInfo($\"{$0}\");"
	},
	"Plugin logger warning": {
		"prefix": "plugin-log-warning",
		"body": "Plugin.Logger.LogWarning($\"{$0}\");"
	},
	"Plugin logger error": {
		"prefix": "plugin-log-error",
		"body": "Plugin.Logger.LogError($\"{$0}\");"
	},
}